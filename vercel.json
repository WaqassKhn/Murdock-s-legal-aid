{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm --prefix frontend ci",
  "buildCommand": "npm --prefix frontend run build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/index.py": {
      "maxDuration": 300,
      "includeFiles": "{backend/app/**,backend/migrations/**,backend/alembic.ini,demo/**}",
      "excludeFiles": "{frontend/**,backend/tests/**,.clean-check/**,.venv/**,.env,data/**,docs/**,evaluation/**,**/node_modules/**,**/__pycache__/**}"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/health",
      "destination": "/api/index"
    }
  ]
}
