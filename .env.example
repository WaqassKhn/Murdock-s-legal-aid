# VERCEL: add only this required value in the dashboard (never a VITE_ variable).
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
LEGALLENS_SESSION_SECRET=

# OPTIONAL LIVE AI: set all three, or leave all empty for labeled local extraction.
# Use a Gemini AI Studio project ONLY with free quota and billing disabled.
# Base URL: https://generativelanguage.googleapis.com/v1beta/openai
# Existing model: gemini-3.5-flash-lite (verify account availability/free tier).
# Model calls are not paid for by Vercel; a billing-enabled key can incur charges.
LEGALLENS_MODEL_BASE_URL=
LEGALLENS_MODEL_API_KEY=
LEGALLENS_MODEL_NAME=

# LOCAL INSTALLATION ONLY. Do not copy these settings into Vercel.
# Vercel ignores local .env and uses request-scoped working files.
LEGALLENS_DATABASE_URL=sqlite:///./data/legallens.db
LEGALLENS_STORAGE_DIR=./data/files
LEGALLENS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000
LEGALLENS_SECURE_COOKIES=false
LEGALLENS_AUTO_MIGRATE=true
LEGALLENS_MAX_UPLOAD_MB=20
LEGALLENS_MAX_WORKSPACE_DOCUMENTS=50
LEGALLENS_MAX_PAGES=200
LEGALLENS_EXPENSIVE_REQUESTS_PER_MINUTE=20
LEGALLENS_SERVERLESS=false
LEGALLENS_TEMPORARY_SESSION=false

# Optional existing local Docker deployment; not needed on Vercel.
POSTGRES_PASSWORD=
# Existing optional integrations; not used on Vercel.
LEGALLENS_SUPABASE_URL=
LEGALLENS_SUPABASE_SECRET_KEY=
LEGALLENS_SUPABASE_BUCKET=legallens-documents
LEGALLENS_EMBEDDING_BASE_URL=
LEGALLENS_EMBEDDING_API_KEY=
LEGALLENS_EMBEDDING_MODEL=
